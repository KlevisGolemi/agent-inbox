# ═══════════════════════════════════════════════════════════════
#  Cowork Queue — configuration
#  install.sh génère ce fichier pour vous ; copiez-le en .env pour une installation manuelle.
#  Valeurs sans guillemets (sauf TRAEFIK_RULE). Ne versionnez jamais .env.
# ═══════════════════════════════════════════════════════════════

# ── Obligatoire ───────────────────────────────────────────────
# URL publique (https obligatoire).
PUBLIC_URL=https://queue.example.com
# Nom d'hôte servi par Caddy : le même que PUBLIC_URL, sans https://.
SITE_HOST=queue.example.com

# ── Compte administrateur (facultatif) ────────────────────────
# Sans ces deux variables, l'application affiche un code de setup dans ses logs :
#   docker compose logs app | grep -i setup
# ADMIN_EMAIL=vous@example.com
# ADMIN_PASSWORD=au-moins-12-caracteres

# ── Variante Traefik (au lieu de Caddy) ───────────────────────
# COMPOSE_FILE=deploy/docker-compose.traefik.yml
# TRAEFIK_NETWORK=traefik_proxy
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_RULE='Host(`queue.example.com`) || Host(`mcp.example.com`)'

# ── Mise à jour en un clic (facultatif) ───────────────────────
# Secret : openssl rand -hex 32
# COMPOSE_PROFILES=updater
# UPDATER_URL=http://updater:8081
# UPDATER_SECRET=

# ── Déploiement ───────────────────────────────────────────────
# Projet Compose (doit rester stable pour l'updater).
COMPOSE_PROJECT_NAME=cowork-queue
# Version de l'image (latest par défaut), ex. 2.0.0.
# VERSION=latest
# Migration depuis la v1 : nom du volume existant à réutiliser (docker volume ls),
# ex. cowork_communication_queue_data. Défaut : cowork-queue-data.
# QUEUE_VOLUME_NAME=cowork-queue-data

# ── Graines de la v1 (lues une seule fois, puis gérées dans l'interface) ──
# WEBHOOK_SECRET=
# TTL_HOURS=48
# CLEANUP_INTERVAL_MIN=60

# ── Avancé ────────────────────────────────────────────────────
# DB_PATH=/data/queue.db
# UPDATE_REPO=KlevisGolemi/cowork-communication
